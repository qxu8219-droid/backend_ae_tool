# Local single-session delivery. This file is NOT loaded automatically.
# Copy to .env.local, edit ISAACSIM_PYTHON, then: set -a; source .env.local; set +a
# Preserve the venv entry point; do not use readlink -f on this path.
ISAACSIM_PYTHON=/absolute/path/to/isaacsim62/bin/python
REPLAY_API_PORT=8000
REPLAY_STORAGE_ROOT=outputs/service
REPLAY_MTX_API_PORT=6197
REPLAY_WHEP_PORT=6189
REPLAY_ICE_PORT=6188
REPLAY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
REPLAY_MAX_UPLOAD_BYTES=67108864
# Optional positive seconds; unset uses the saved mapping/default gap policy.
# B041 has its own source-age and integration-gap policy too.
# REPLAY_MAX_GAP_S=0.25
